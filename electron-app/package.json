{
    "name": "echo-voice-assistant",
    "version": "1.0.0",
    "description": "Minimalist voice-controlled desktop assistant with Gemini Live",
    "repository": "github:Precision-Recall/Echo",
    "main": "electron-main.js",
    "author": "ECHO Team",
    "license": "MIT",
    "dependencies": {
        "electron-is-dev": "^2.0.0"
    },
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1"
    },
    "scripts": {
        "start": "electron .",
        "prebuild:backend": "python build_backend.py",
        "build": "npm run prebuild:backend && electron-builder --win --x64",
        "build:win": "npm run prebuild:backend && electron-builder --win --x64",
        "build:linux": "npm run prebuild:backend && electron-builder --linux --x64",
        "build:mac": "npm run prebuild:backend && electron-builder --mac --x64",
        "build:all": "npm run prebuild:backend && electron-builder --win --linux --mac",
        "build:electron-only": "electron-builder --win --x64"
    },
    "build": {
        "extends": null,
        "appId": "com.echo.voice-assistant",
        "productName": "ECHO Voice Assistant",
        "files": [
            "electron-main.js",
            "preload.js",
            "ui/**/*",
            "!backend/**/*",
            "!build_backend.py"
        ],
        "extraResources": [
            {
                "from": "dist/backend",
                "to": "backend",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "ui/icon.ico"
        },
        "linux": {
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "ui/icon.png",
            "category": "Utility"
        },
        "mac": {
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "ui/icon.icns",
            "category": "public.app-category.utilities"
        },
        "directories": {
            "output": "dist"
        }
    }
}