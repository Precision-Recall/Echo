{
    "name": "echo-voice-assistant",
    "version": "1.0.0",
    "description": "Minimalist voice-controlled desktop assistant with Gemini Live",
    "main": "electron-main.js",
    "author": "ECHO Team",
    "license": "MIT",
    "dependencies": {
        "electron-is-dev": "^2.0.0"
    },
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^23.6.0"
    },
    "scripts": {
        "start": "electron .",
        "build": "electron-builder --win portable"
    },
    "build": {
        "extends": null,
        "appId": "com.echo.voice-assistant",
        "productName": "ECHO Voice Assistant",
        "files": [
            "electron-main.js",
            "preload.js",
            "ui/**/*",
            "backend/**/*"
        ],
        "win": {
            "target": "portable"
        },
        "directories": {
            "output": "dist"
        }
    }
}