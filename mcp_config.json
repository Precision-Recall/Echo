{
  "enable_diagnostic_tools": true,
  "mcp_servers": {
    "windows-mcp": {
      "transport": "streamable_http",
      "url": "http://127.0.0.1:8000/mcp",
      "enabled": false
    },
    "playwright": {
      "transport": "stdio",
      "command": "npx",
      "args": ["@playwright/mcp@latest"],
      "enabled": true
    },
    "diagnostic-mcp": {
      "transport": "stdio",
      "command": "python",
      "args": ["-m", "system_diagnosis_mcp"],
      "enabled": true
    }
  }
}
